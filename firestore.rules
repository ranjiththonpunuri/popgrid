rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /games/{gameId} {
      // Any authenticated user can read game docs
      allow read: if request.auth != null;

      // Only authenticated users can create games
      allow create: if request.auth != null
        && request.resource.data.player1.sessionId == request.auth.uid;

      // Updates: authenticated users who are part of the game
      allow update: if request.auth != null
        && (
          // Player2 joining (filling empty slot)
          (resource.data.status == 'waiting'
           && request.resource.data.player2.sessionId == request.auth.uid)
          ||
          // Game participants can update during play
          (resource.data.player1.sessionId == request.auth.uid
           || resource.data.player2.sessionId == request.auth.uid)
        );

      allow delete: if false;
    }

    match /matchmaking_queue/{docId} {
      // Any authenticated user can read and write queue entries
      allow read, write: if request.auth != null;
    }
  }
}
